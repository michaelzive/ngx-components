<div class="magicpath-layout">
  <app-docking-layout>
    <!-- Top Docking Panel -->
    <app-docking-panel slot="top" [initialSize]="120" [collapsedSize]="32" [autoFocus]="true">
      <ng-template dockingPanelTab="Properties" icon="settings">
        <div class="properties-panel">
          <h3>Properties Panel</h3>
          <p>Configure component properties and settings here.</p>
          <div class="properties-grid">
            <div class="property-group">
              <label for="width-input">Width</label>
              <input id="width-input" type="text" value="320px" />
            </div>
            <div class="property-group">
              <label for="height-input">Height</label>
              <input id="height-input" type="text" value="200px" />
            </div>
            <div class="property-group">
              <label for="x-input">X Position</label>
              <input id="x-input" type="text" value="0" />
            </div>
            <div class="property-group">
              <label for="y-input">Y Position</label>
              <input id="y-input" type="text" value="0" />
            </div>
            <div class="property-group">
              <label for="opacity-input">Opacity</label>
              <input id="opacity-input" type="text" value="1.0" />
            </div>
            <div class="property-group">
              <label for="rotation-input">Rotation</label>
              <input id="rotation-input" type="text" value="0deg" />
            </div>
          </div>
        </div>
      </ng-template>
      
      <ng-template dockingPanelTab="Inspector" icon="search">
        <div class="inspector-panel">
          <h3>Inspector</h3>
          <p>Inspect and debug your components.</p>
          <div class="inspector-tree">
            <div class="tree-item">🔧 App Component</div>
            <div class="tree-item indent-1">📄 Docking Layout</div>
            <div class="tree-item indent-2">📊 Top Panel</div>
            <div class="tree-item indent-2">📊 Right Panel</div>
            <div class="tree-item indent-2">📊 Bottom Panel</div>
            <div class="tree-item indent-1">🔀 Splitter</div>
            <div class="tree-item indent-2">📝 Canvas Panel</div>
            <div class="tree-item indent-2">👁️ Preview Panel</div>
          </div>
        </div>
      </ng-template>
      
      <ng-template dockingPanelTab="Styles" icon="palette">
        <div class="styles-panel">
          <h3>Styles</h3>
          <p>Manage CSS styles and themes.</p>
          <div class="styles-grid">
            <div class="style-group">
              <label>Background</label>
              <div class="color-picker">#ffffff</div>
            </div>
            <div class="style-group">
              <label>Border</label>
              <div class="color-picker">#e5e7eb</div>
            </div>
            <div class="style-group">
              <label>Text</label>
              <div class="color-picker">#111827</div>
            </div>
            <div class="style-group">
              <label>Accent</label>
              <div class="color-picker">#3b82f6</div>
            </div>
          </div>
        </div>
      </ng-template>
    </app-docking-panel>

    <!-- Left Docking Panel -->
    <app-docking-panel slot="left" [initialSize]="280" [collapsedSize]="32" [autoFocus]="true">
      <ng-template dockingPanelTab="Explorer" icon="folder">
        <div class="explorer-panel">
          <h3>File Explorer</h3>
          <p>Browse and manage your project files.</p>
          <div class="file-tree">
            <div class="file-item folder">📁 src</div>
            <div class="file-item file indent-1">📄 index.html</div>
            <div class="file-item file indent-1">📄 main.ts</div>
            <div class="file-item folder indent-1">📁 app</div>
            <div class="file-item file indent-2">📄 app.component.ts</div>
            <div class="file-item file indent-2">📄 app.component.html</div>
            <div class="file-item file indent-2">📄 app.component.scss</div>
            <div class="file-item folder indent-2">📁 components</div>
            <div class="file-item file indent-3">📄 docking-panel.component.ts</div>
            <div class="file-item file indent-3">📄 splitter.component.ts</div>
          </div>
        </div>
      </ng-template>
      
      <ng-template dockingPanelTab="Search" icon="search">
        <div class="search-panel">
          <h3>Search</h3>
          <p>Find files, symbols, and references across your project.</p>
          <div class="search-form">
            <input type="text" placeholder="Search..." class="search-input" />
            <div class="search-options">
              <label><input type="checkbox" /> Match case</label>
              <label><input type="checkbox" /> Whole word</label>
              <label><input type="checkbox" /> Use regex</label>
            </div>
          </div>
          <div class="search-results">
            <div class="result-item">
              <div class="result-file">📄 app.component.ts</div>
              <div class="result-line">Line 15: export class AppComponent</div>
            </div>
            <div class="result-item">
              <div class="result-file">📄 main.ts</div>
              <div class="result-line">Line 3: import { AppComponent }</div>
            </div>
          </div>
        </div>
      </ng-template>
    </app-docking-panel>

    <!-- Right Docking Panel -->
    <app-docking-panel slot="right" [initialSize]="220" [collapsedSize]="32" [autoFocus]="true">
      <ng-template dockingPanelTab="Details" icon="info">
        <div class="details-panel">
          <h3>Component Details</h3>
          <p>View detailed information about selected components.</p>
          <div class="details-list">
            <div class="detail-item">
              <span class="detail-label">Type:</span>
              <span class="detail-value">DockingPanel</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">ID:</span>
              <span class="detail-value">panel-001</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">State:</span>
              <span class="detail-value">Expanded</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Size:</span>
              <span class="detail-value">280px</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Tabs:</span>
              <span class="detail-value">1</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Resizable:</span>
              <span class="detail-value">Yes</span>
            </div>
          </div>
        </div>
      </ng-template>
    </app-docking-panel>

    <!-- Bottom Docking Panel -->
    <app-docking-panel slot="bottom" [initialSize]="140" [collapsedSize]="32">
      <ng-template dockingPanelTab="Console" icon="terminal">
        <div class="console-panel">
          <h3>Console</h3>
          <p>View logs and console output.</p>
          <div class="console-output">
            <div class="log-entry info">✓ Component initialized successfully</div>
            <div class="log-entry warn">⚠ Panel resize detected</div>
            <div class="log-entry info">✓ Tab switched to Inspector</div>
            <div class="log-entry error">✗ WebSocket connection failed</div>
            <div class="log-entry info">✓ Reconnecting...</div>
            <div class="log-entry success">✓ Connection restored</div>
          </div>
        </div>
      </ng-template>
    </app-docking-panel>

    <!-- Main Content Area with Horizontal Splitter -->
    <div slot="main" class="main-content">
      <app-splitter 
        layout="horizontal" 
        [panelSizes]="mainPanelSizes()" 
        (sizesChange)="onMainSizeChange($event)">
        
        <!-- Design Canvas Panel -->
        <app-splitter-panel ariaLabel="Design Canvas">
          <div class="design-canvas">
            <header class="canvas-header">
              <h2>Design Canvas</h2>
              <p>Main workspace for design and layout</p>
            </header>
            <main class="canvas-content">
              <div class="canvas-area">
                <h3>Canvas Area</h3>
                <div class="drop-zone">
                  <div class="drop-icon">📋</div>
                  <p>Drop components here to start designing</p>
                </div>
              </div>
              <div class="quick-actions">
                <h3>Quick Actions</h3>
                <div class="action-buttons">
                  <button type="button" class="action-btn">
                    <span>Add Component</span>
                    <small>Insert new element</small>
                  </button>
                  <button type="button" class="action-btn">
                    <span>Import Asset</span>
                    <small>Upload resources</small>
                  </button>
                </div>
              </div>
            </main>
          </div>
        </app-splitter-panel>

        <!-- Preview & Code Panel -->
        <app-splitter-panel ariaLabel="Preview & Code">
          <div class="preview-code">
            <header class="preview-header">
              <h2>Preview & Code</h2>
              <p>Live preview and code generation</p>
            </header>
            <main class="preview-content">
              <div class="live-preview">
                <h3>Live Preview</h3>
                <div class="preview-viewport">
                  <!-- Placeholder preview area -->
                  <div class="preview-placeholder">
                    Preview area coming soon...
                  </div>
                </div>
              </div>
              <div class="generated-code">
                <h3>Generated Code</h3>
                <pre class="code-block">&lt;div className="component"&gt;
  &lt;h1&gt;Hello World&lt;/h1&gt;
  &lt;p&gt;Generated component&lt;/p&gt;
&lt;/div&gt;</pre>
              </div>
            </main>
          </div>
        </app-splitter-panel>
      </app-splitter>
    </div>
  </app-docking-layout>
</div>
